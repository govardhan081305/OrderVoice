# Copy to server/.env and edit. Every value is optional for local development.

PORT=4000
NODE_ENV=development

# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Secret code required to create an ADMIN account on the sign-up page.
# Customers and delivery partners sign up freely; admins need this code.
# If unset: development prints a random code at startup; production disables admin sign-up.
ADMIN_SIGNUP_CODE=app-admin-2003

# Database: SQLite file by default. For PostgreSQL: `npm i pg` and set DATABASE_URL.
# SQLITE_PATH=./data/ordervoice.db
# DATABASE_URL=postgres://user:pass@host:5432/ordervoice

# OrderVoice call rules
# Minutes calling stays open after delivery (0 = closes immediately on delivery)
CALL_GRACE_MINUTES=0
CALL_RING_TIMEOUT_SEC=30
CALL_MAX_PER_10_MIN=6

# ICE servers
STUN_URLS=stun:stun.l.google.com:19302
# Your own coturn server (see deploy/turnserver.conf). Leave empty to use STUN only.
# TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
# TURN_SECRET=same-value-as-static-auth-secret-in-turnserver.conf
TURN_TTL_SEC=3600
# No server of your own? Use a free hosted TURN instead (Metered Open Relay: 20 GB/month,
# sign up at https://www.metered.ca/tools/openrelay/ and copy the values from "Show ICE Servers Array").
# Used only when TURN_SECRET is empty:
TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=8448dbb57aeab216fcce48fd
TURN_PASSWORD=gKSYUh3RpTDZaTa3

# Cost-model defaults shown on the admin dashboard (ASSUMPTIONS: replace with real quotes)
COST_PSTN_RATE_PER_MIN=0.6
COST_EGRESS_PER_GB=7.5

# ---- Maps & location (free OpenStreetMap services, no API key) ----
# Orders must be within this distance of the restaurant
DELIVERY_RADIUS_KM=30
# Address lookup/search (Nominatim) and road routes (OSRM). Self-host these for heavy production use.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GEO_USER_AGENT=OrderVoice/1.0 (college project; food delivery demo)
GEO_COUNTRY=in

# ---- Ring the phone when the app is closed (Web Push) ----
# Leave empty to auto-generate (saved in data/vapid.json). Or generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact the push services can reach you at
VAPID_SUBJECT=mailto:admin@example.com

CORS_ORIGIN=*
